# Which allowlist to enforce: prod | stage | dev
INOUT_ENV=stage

# Platform ID in the provider's system, issued at integration
INOUT_AGGREGATOR_ID=00000000-0000-0000-0000-000000000000

# Our brand ID with the provider
INOUT_SUB_ID=bsexchange

# Derived from the two above via md5-seeded UUIDv4 (bonus spec 7).
# Leave blank to compute it at boot; set it once the provider confirms the value.
INOUT_SUB_OPERATOR_ID=

# HMAC-SHA256 key given by the provider on connection. Never commit.
INOUT_SIGNATURE_KEY=

# Shown in-game and used for the "back to lobby" button
INOUT_BRAND_NAME=BS Exchange
INOUT_LOBBY_URL=https://bsexchange.live/casino

# Extra source IPs to allow while testing (comma separated). Leave empty in prod.
INOUT_EXTRA_IPS=

# Number of reverse proxies in front of Nest (Cloudflare + nginx = 2)
TRUST_PROXY_HOPS=2
